# ---------------------------------------------------------------------------
# DealGuard environment variables
# Copy to .env.local for development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role. Server-side only: it bypasses row
# level security and must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ----------------------------------------------------------------
# Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...

# Developers -> Webhooks -> your endpoint -> signing secret.
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (not product IDs) for the recurring monthly prices.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Optional: pin the Stripe API version instead of using the account default.
# STRIPE_API_VERSION=2025-02-24.acacia

# --- App -------------------------------------------------------------------
# Absolute origin, used for Stripe redirects and email confirmation links.
# On Vercel this is inferred; set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
